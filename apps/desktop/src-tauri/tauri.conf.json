{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bellows",
  "version": "0.0.1-beta",
  "identifier": "dev.bellows.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bellows-core"],
    "shortDescription": "Local QQ chat bot workbench",
    "longDescription": "Bellows (风箱) is a local QQ chat bot workbench. The desktop shell starts the bundled Python core and opens the web UI."
  }
}
