# Bellows 本地运行配置示例
# 复制为 .env（不要提交）后按需修改；scripts/run.sh 直接读取环境变量。

# 监听端口
BELLOWS_PORT=7801

# 数据目录（SQLite 存放处）
BELLOWS_DATA_DIR=./data

# 可选：设置后除 /api/health 外的 API 与事件流都需要 Bearer Token
# 强烈建议对外暴露时设置
BELLOWS_TOKEN=

# uvicorn 日志级别：critical | error | warning | info | debug
BELLOWS_LOG_LEVEL=info

# Docker Compose 使用（可选）
BELLOWS_IMAGE_TAG=0.0.1-beta
